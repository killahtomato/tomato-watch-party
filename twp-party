#!/bin/bash
# Start Movie Stream server + ngrok tunnel for remote watch party
# Usage: ./twp-party

cd "$(dirname "$0")"

# Check dependencies
if [ ! -d "server/node_modules" ]; then
  echo "Installing server dependencies..."
  cd server && npm install && cd ..
fi

if [ ! -d "client/node_modules" ]; then
  echo "Installing client dependencies..."
  cd client && npm install && npm run build && cd ..
fi

# Check ngrok
if ! command -v ngrok &>/dev/null; then
  echo "ngrok not found. Install from https://ngrok.com/download"
  exit 1
fi

# Kill any existing processes on port 3000
lsof -ti:3000 2>/dev/null | xargs kill -9 2>/dev/null

echo ""
echo "========================================"
echo "  Starting Movie Stream Party Server"
echo "========================================"
echo ""

# Start ngrok in background
ngrok http 3000 > /tmp/ngrok.log 2>&1 &
NGROK_PID=$!
echo "ngrok starting (PID: $NGROK_PID)..."

# Wait for ngrok to get a URL
sleep 3

# Get the public URL
NGROK_URL=$(curl -s http://localhost:4040/api/tunnels | grep -o '"public_url":"[^"]*"' | head -1 | cut -d'"' -f4)

if [ -n "$NGROK_URL" ]; then
  echo ""
  echo "  Share this URL with your friend:"
  echo "  ➜  $NGROK_URL"
  echo ""
  echo "  (Local: http://localhost:3000)"
  echo ""
else
  echo "  ngrok starting... check http://localhost:4040 for the URL"
  echo ""
fi

echo "Press Ctrl+C to stop both server and tunnel."
echo ""

# Start the server in foreground
cd server && node index.js

# Cleanup ngrok on exit
kill $NGROK_PID 2>/dev/null
