#!/bin/bash
# Start Tomato Watch Party server + Cloudflare Tunnel
# Usage: ./twp-party

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo "Usage: ./twp-party"
  echo "  Start the Tomato Watch Party server with a Cloudflare Tunnel."
  echo "  Installs dependencies if missing, starts cloudflared, and shows a shareable URL."
  echo "  Requires cloudflared: sudo pacman -S cloudflared"
  exit 0
fi

cd "$(dirname "$0")"

# Check dependencies
if [ ! -d "server/node_modules" ]; then
  echo "Installing server dependencies..."
  cd server && npm install && cd ..
fi

if [ ! -d "client/node_modules" ]; then
  echo "Installing client dependencies..."
  cd client && npm install && npm run build && cd ..
fi

# Check cloudflared
if ! command -v cloudflared &>/dev/null; then
  echo "cloudflared not found. Install from https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/install-and-setup/installation/"
  exit 1
fi

# Kill any existing processes
./twp-kill 2>/dev/null

echo ""
echo "========================================"
echo "  Starting Tomato Watch Party"
echo "========================================"
echo ""

# Start the server in background
setsid node server/index.js > server.log 2>&1 < /dev/null &
echo "Server starting on http://localhost:3000..."

# Wait for server
sleep 3

# Start cloudflared in background
nohup cloudflared tunnel --url http://localhost:3000 > cloudflared.log 2>&1 &
echo "Cloudflare Tunnel starting..."

# Wait for tunnel URL
sleep 5
TUNNEL_URL=$(grep -o 'https://[^ ]*trycloudflare.com' cloudflared.log | head -1)

if [ -n "$TUNNEL_URL" ]; then
  echo ""
  echo "  Share this URL with your friends:"
  echo "  ➜  $TUNNEL_URL"
  echo ""
  echo "  (Local: http://localhost:3000)"
  echo ""
else
  echo "  Tunnel starting... check cloudflared.log for the URL"
  echo ""
fi

echo "Press Ctrl+C to stop server and tunnel."
echo ""

# Wait for interrupt
trap 'echo "Stopping..."; ./twp-kill 2>/dev/null; exit 0' INT TERM
while true; do sleep 1; done
