# Host password for authentication.
# The server refuses to start while this is unset or still "changeme".
# Generate one with: openssl rand -base64 24
HOST_PASSWORD=

# Secret for JWT signing.
# The server refuses to start while this is unset or still the default.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Port to run the server on
PORT=3000

# Directory containing movie files (absolute or relative path)
MOVIE_DIR=./movies

# Directory containing DJ audio tracks (absolute or relative path)
MUSIC_DIR=./music

# Directory for transcoded stream files (cached MP4 files)
STREAM_DIR=./streams

# Directory for small persistent state (playback order, skip profiles, resume state)
DATA_DIR=./data

# Node environment
NODE_ENV=production

# Enable debug logging (set to 1 to enable verbose WebSocket logging)
DEBUG=0

# Log file path
LOG_FILE=./server.log

# Transcode encoder (auto-detected at startup if unset)
# Options: libx264, h264_nvenc (NVIDIA), h264_qsv (Intel), h264_vaapi (AMD/Intel Linux)
TRANSCODE_ENCODER=

# Enable web search/streaming via the vendored tomato-play submodule.
TOMATOPLAY_ENABLED=1

# Path to the tomato-play CLI (relative to the project root).
TOMATOPLAY_BIN=server/vendor/tomato-play/tomatoplay

# Optional per-request timeout in milliseconds (default 30000)
# TOMATOPLAY_TIMEOUT_MS=30000

# Lifetime of the signed web stream proxy URLs (default 4h).
# WEB_STREAM_TOKEN_TTL=4h
