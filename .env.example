# Host password for authentication
HOST_PASSWORD=changeme

# Secret for JWT signing (change to a long random string)
JWT_SECRET=change-this-to-a-random-secret-key

# Port to run the server on
PORT=3000

# Directory containing movie files (absolute or relative path)
MOVIE_DIR=./movies

# Directory for HLS transcoding segments (ephemeral, cleared on movie switch)
HLS_DIR=./hls

# Node environment
NODE_ENV=production
