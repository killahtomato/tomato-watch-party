# Host password for authentication.
# The server refuses to start while this is unset or still "changeme".
HOST_PASSWORD=changeme

# Secret for JWT signing.
# The server refuses to start while this is unset or still the default below.
JWT_SECRET=change-this-to-a-random-secret-key

# Port to run the server on
PORT=3000

# Directory containing movie files (absolute or relative path)
MOVIE_DIR=./movies

# Directory for transcoded stream files (cached MP4 files)
STREAM_DIR=./streams

# Node environment
NODE_ENV=production

# Enable debug logging (set to 1 to enable verbose WebSocket logging)
DEBUG=0

# Log file path
LOG_FILE=./server.log

# Transcode encoder (auto-detected at startup if unset)
# Options: libx264, h264_nvenc (NVIDIA), h264_qsv (Intel), h264_vaapi (AMD/Intel Linux)
TRANSCODE_ENCODER=
