#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

print_help() {
  cat <<'EOF'
Tomato Watch Party — command launcher

Usage:
  twp <command> [args...]

Commands:
  start [--background|-b]   Start the server on http://localhost:3000
  kill                      Stop server, ffmpeg jobs, tunnels and cloudflared
  party [--background|-b]   Start server + Cloudflare Tunnel (shareable URL)
  transcode [--hqonly]      Batch transcode all movies (1080p only with --hqonly)
                            --audio-only re-extracts cached audio, --prewarm-audio extracts after transcoding
  backup [path]             Write a dated backup archive (secrets excluded)
  help                      Show this help

Environment:
  HQONLY=1                  1080p-only batch transcoding (same as --hqonly)
  TWP_BACKUP_DIR            Backup output directory (default ~/Work/backups)
  HQ_ONLY                   Server derives no lower qualities by default; set HQ_ONLY=0 to enable
  PREWARM_REMUX=1           Pre-create full-video remuxes for alternate audio tracks

Examples:
  ./twp start
  ./twp party --background
  ./twp transcode --hqonly
  ./twp backup
EOF
}

case "${1:-}" in
  ""|-h|--help|help)
    print_help
    exit 0
    ;;
  start)
    shift
    exec "$SCRIPT_DIR/twp-start" "$@"
    ;;
  kill)
    shift
    exec "$SCRIPT_DIR/twp-kill" "$@"
    ;;
  party)
    shift
    exec "$SCRIPT_DIR/twp-party" "$@"
    ;;
  transcode)
    shift
    exec "$SCRIPT_DIR/twp-transcode" "$@"
    ;;
  backup)
    shift
    exec "$SCRIPT_DIR/twp-backup" "$@"
    ;;
  *)
    echo "twp: unknown command '$1'" >&2
    print_help >&2
    exit 1
    ;;
esac
